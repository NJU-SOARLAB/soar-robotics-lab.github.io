---
layout: default
---
{% assign current_lang = page.lang | default: site.default_lang | default: 'zh' %}
{% if current_lang == 'en' %}
  {% assign news_kicker = 'Latest' %}
  {% assign news_title = 'News' %}
  {% assign news_url = '/news/' %}
  {% assign news_more = 'All news' %}
  {% assign selected_papers_kicker = 'Research' %}
  {% assign selected_papers_title = 'Selected Publications' %}
  {% assign selected_papers_url = '/publications/' %}
  {% assign selected_papers_more = 'All publications' %}
  {% assign contact_note = 'Prospective students should include a CV, WeChat ID, and a concise research statement in the application email.' %}
{% else %}
  {% assign news_kicker = 'Latest' %}
  {% assign news_title = '新闻' %}
  {% assign news_url = '/zh/news/' %}
  {% assign news_more = '全部新闻' %}
  {% assign selected_papers_kicker = 'Research' %}
  {% assign selected_papers_title = '代表论文' %}
  {% assign selected_papers_url = '/zh/publications/' %}
  {% assign selected_papers_more = '全部论文' %}
  {% assign contact_note = '申请同学请在邮件中附上简历、微信号和简要研究设想。' %}
{% endif %}
<div class="post soar-home">
  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="soar-section" id="news">
        <header class="soar-section__head">
          <p class="soar-kicker">{{ news_kicker }}</p>
          <h2>{{ news_title }}</h2>
          <a class="soar-section__more" href="{{ news_url | relative_url }}">{{ news_more }} →</a>
        </header>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="soar-section">
        <header class="soar-section__head">
          <h2><a href="{{ '/blog/' | relative_url }}">latest posts</a></h2>
        </header>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="soar-section" id="selected-publications">
        <header class="soar-section__head">
          <p class="soar-kicker">{{ selected_papers_kicker }}</p>
          <h2>{{ selected_papers_title }}</h2>
          <a class="soar-section__more" href="{{ selected_papers_url | relative_url }}">{{ selected_papers_more }} →</a>
        </header>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
